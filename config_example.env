# =============================================================================
# CONFIGURACIÓN DEL TRADING BOT - PROFESSIONAL EDITION
# =============================================================================

# API KEYS DE BINANCE
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_BASE_URL=https://testnet.binance.vision
ENVIRONMENT=testnet

# DISCORD NOTIFICATIONS
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here

# CONFIGURACIÓN DE TRADING
MIN_CONFIDENCE_THRESHOLD=0.80
MIN_SELL_CONFIDENCE_THRESHOLD=0.90
SIGNAL_REVERSAL_THRESHOLD=0.99

# GESTIÓN DE RIESGO
STOP_LOSS_PERCENT=1.5
TAKE_PROFIT_PERCENT=1.9
TRAILING_STOP_PERCENT=1.2
MIN_PROFIT_PROTECTION=0.38
TRAILING_ACTIVATION_THRESHOLD=0.45
MAX_DAILY_LOSS_PERCENT=10.0
MAX_POSITION_VALUE_USDT=30.0
MIN_POSITION_VALUE_USDT=11.0

# ✅ NUEVO: PROTECCIÓN POST-PÉRDIDAS
# Tiempos de cooldown según magnitud de la pérdida
LOSS_PROTECTION_SMALL_LOSS_COOLDOWN=15      # Minutos para pérdida < 2%
LOSS_PROTECTION_MEDIUM_LOSS_COOLDOWN=30     # Minutos para pérdida 2-5%
LOSS_PROTECTION_LARGE_LOSS_COOLDOWN=60      # Minutos para pérdida > 5%

# Protección por múltiples pérdidas consecutivas
LOSS_PROTECTION_CONSECUTIVE_PENALTY=90      # Minutos adicionales por pérdidas consecutivas
LOSS_PROTECTION_MAX_CONSECUTIVE_LOSSES=3    # Máximo 3 pérdidas seguidas

# Protección por pérdida diaria acumulada
LOSS_PROTECTION_DAILY_LOSS_THRESHOLD=10.0   # % pérdida diaria para activar protección
LOSS_PROTECTION_DAILY_LOSS_PENALTY=120      # Minutos de pausa por pérdida diaria

# Configuración específica
LOSS_PROTECTION_SYMBOL_SPECIFIC=true        # Cooldown por símbolo vs global
LOSS_PROTECTION_BYPASS_CONFIDENCE=95.0      # % confianza para bypass
LOSS_PROTECTION_BYPASS_ENABLED=true         # Permitir bypass con alta confianza

# PORTFOLIO DIVERSIFICATION
MAX_SYMBOL_EXPOSURE_PERCENT=35.0
MAX_TOTAL_EXPOSURE_PERCENT=80.0

# SMART DISCORD NOTIFIER
DISCORD_MIN_TRADE_VALUE_USD=10.0
DISCORD_MIN_PNL_PERCENT_NOTIFY=0.7
DISCORD_MAX_NOTIFICATIONS_PER_HOUR=8
DISCORD_MAX_NOTIFICATIONS_PER_DAY=40
DISCORD_SUPPRESS_SIMILAR_MINUTES=10
DISCORD_ONLY_PROFITABLE_TRADES=false
DISCORD_EMERGENCY_ONLY_MODE=false
